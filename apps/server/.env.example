# Precious Local — environment variables
PORT=3001
NODE_ENV=production
DATA_DIR=/data
DATABASE_PATH=/data/precious.db

# Generated on first run if missing (64 hex chars = 32 bytes)
# ENCRYPTION_KEY=

# Optional: path to built Next.js static export
# WEB_DIST=/app/web/out

# Optional: CORS origin for web dev
# WEB_ORIGIN=http://localhost:3000

# Optional: require password for API access (default = no auth)
# PRECIOUS_LOCAL_PASSWORD=your-secret
